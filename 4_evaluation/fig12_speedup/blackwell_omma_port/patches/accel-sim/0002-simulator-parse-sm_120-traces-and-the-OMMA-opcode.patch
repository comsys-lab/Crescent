index 0000000..eff5a3b
--- /dev/null
+++ b/gpu-simulator/ISA_Def/blackwell_opcode.h
@@ -0,0 +1,33 @@
+// Blackwell (sm_120, e.g. RTX PRO 4000 Blackwell / RTX 50xx) opcode map.
+//
+// ASSUMPTION: sm_120 SASS is the Hopper (sm_90) SASS opcode set plus the
+// additions listed below. Only opcodes actually observed in sm_120 traces
+// are added; everything else falls through to the Hopper classification.
+
+#ifndef BLACKWELL_OPCODE_H
+#define BLACKWELL_OPCODE_H
+
+#include <string>
+#include <unordered_map>
+#include "abstract_hardware_model.h"
+#include "hopper_opcode.h"
+#include "trace_opcode.h"
+
+#define BLACKWELL_RTX_BINART_VERSION 120
+
+static const std::unordered_map<std::string, OpcodeChar> Blackwell_OpcodeMap =
+    [] {
+      std::unordered_map<std::string, OpcodeChar> m = Hopper_OpcodeMap;
+      // Warp-level block-scaled MMA (e.g. OMMA.SF.16864.F32.E2M1.E2M1.UE4M3.4X
+      // from mma.sync...kind::mxf4nvf4.block_scale). Runs on the per-sub-core
+      // tensor core, like HMMA/IMMA.
+      m.insert({"OMMA", OpcodeChar(OP_OMMA, SPECIALIZED_UNIT_3_OP)});
+      // Load constant into a uniform register (sm_120 replacement of ULDC).
+      m.insert({"LDCU", OpcodeChar(OP_ULDC, SPECIALIZED_UNIT_4_OP)});
+      // Read a special register (e.g. SR_CLOCKLO for clock64) into a uniform
+      // register (sm_120); same class as S2UR.
+      m.insert({"CS2UR", OpcodeChar(OP_S2UR, SPECIALIZED_UNIT_4_OP)});
+      return m;
+    }();
+
+#endif
