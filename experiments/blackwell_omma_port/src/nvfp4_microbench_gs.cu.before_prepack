// Largest-error-selection metadata config -- must be defined before collective_builder.hpp
// pulls in the patched sm120_blockscaled_mma_tma.hpp (its own #ifndef defaults are Linear
// mode). Override via -D from build.sh:
//   Linear (A@W^T):  NVFP4_META_GROUP_SIZE=4 NVFP4_META_ON_B=0 (default)
//   QK^T (attention): NVFP4_META_GROUP_SIZE=8 NVFP4_META_ON_B=1
#ifndef NVFP4_META_GROUP_SIZE
#define NVFP4_META_GROUP_SIZE 4
#endif
#ifndef NVFP4_META_ON_B
#define NVFP4_META_ON_B 0
#endif
// NVFP4_META_ENABLE=0 builds against an UNPATCHED CUTLASS checkout (no metaA/metaB
// TMA loading at all) for baseline (no-metadata) A/B timing comparisons.
#ifndef NVFP4_META_ENABLE
#define NVFP4_META_ENABLE 1
#endif
// NVFP4_NIBBLE_PACK=1 (quantize-kernel-only experiment, GS must be 4): each metadata
// value is only 4 bits (2-bit index + 2-bit E2M3 correction), so pack 2 adjacent
// groups' values into 1 byte instead of 1 byte/group. Halves bytes written, landing
// the per-row byte width exactly on the TMA 16-byte floor (same as group=8's natural
// width) while keeping group=4's finer selection granularity. GEMM-side timing for
// this is modeled by reusing the group=8 CUTLASS binary (same K/8 byte-row layout).
#ifndef NVFP4_NIBBLE_PACK
#define NVFP4_NIBBLE_PACK 0
#endif
// NVFP4_WORD_PACK8=1 (GS must be 8, NG=2): pack both groups' 5-bit values (index+correction)
// into a single uint16_t store instead of two independent uint8_t stores. Same total bytes
// as the naive per-group byte store (16B/row for K=128) -- this only tests whether replacing
// 2 byte-stores with 1 halfword-store changes the quantize kernel's write cost.
#ifndef NVFP4_WORD_PACK8
#define NVFP4_WORD_PACK8 0
#endif
// NVFP4_DENSE_PACK8=1 (GS must be 8): fully dense bit-packing, no byte/word alignment --
// 8 groups (2 per thread's 16-elem chunk x 4 consecutive threads) x 5 bits = 40 bits =
// exactly 5 bytes, written by one "leader" thread per group-of-4 after gathering the other
// 3 threads' values via warp shuffle. 10 bytes/row for K=128 (vs 16B naive) -- tests whether
// the real write-side savings justify the added cross-thread-boundary complexity.
#ifndef NVFP4_DENSE_PACK8
#define NVFP4_DENSE_PACK8 0
#endif
// NVFP4_META_TRANSPOSE=1: metaA stored (M,K/GS,L) with M contiguous (stride 1) instead of
// K/GS contiguous -- see sm120_blockscaled_mma_tma.hpp. The quantize kernel's write becomes
// strided (consecutive threads, same row, different K-groups -> addresses NG*M apart) instead
// of coalesced -- tests whether the GEMM-side win (wider TMA row) survives this write-side cost.
#ifndef NVFP4_META_TRANSPOSE
#define NVFP4_META_TRANSPOSE 0
#endif
// NVFP4_META_PAIR16=1 (GS=16): row-pair correction-data layout, see the CUTLASS patch.
#ifndef NVFP4_META_PAIR16
#define NVFP4_META_PAIR16 0
#endif

